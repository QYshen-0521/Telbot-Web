# INDI (on Raspberry Pi, telbot CLI connects here)
TELBOT_INDI_HOST=127.0.0.1
TELBOT_INDI_PORT=7624
# Run: indi_getprop -p 7624 | find telescope device name
TELBOT_INDI_DEVICE=Losmandy Gemini
# PlaneWave L350（USB 1cbe:0267 选镜后自动写入）：TELBOT_INDI_DEVICE=PlaneWave
# 为 true 时由 /run/telbot/indi_device_hint + indi_getprop + USB 解析望远镜设备名（见 docs/MOUNT_AUTO.md）
# 多镜现场推荐 true；telbot-select-mount.sh 成功选镜后会自动写入本项与 TELBOT_INDI_DEVICE
TELBOT_INDI_DEVICE_AUTO=true
# TELBOT_INDI_DEVICE_HINT_PATH=
# CCD for `telbot camera snap` / VoiceIntent snap（与 indi_getprop 设备名一致，可含空格）
# ZWO ASI：用完整设备名，不要用驱动族名 "ZWO CCD"
# TELBOT_INDI_CCD_DEVICE=ZWO CCD ASI294MC Pro
# QHY174M：用完整设备名，不要用驱动族名 "QHY CCD"
# TELBOT_INDI_CCD_DEVICE=QHY CCD QHY174M
# SBIG 示例：TELBOT_INDI_CCD_DEVICE=SBIG CCD
# 边拍边叠（telbot camera live-stack / HTTP live-stack）：pip install -e ".[livestack]"
# TELBOT_LIVE_STACK_PREVIEW_MAX_PX=1024
# TELBOT_LIVE_STACK_CAL_BIAS_DIR=/home/qyshen/Telbot/data/ccd_captures/20260604/bias_1129
# TELBOT_LIVE_STACK_CAL_DARK_DIR=...
# TELBOT_LIVE_STACK_CAL_FLAT_DIR=...
# 校准帧（telbot camera cal bias|dark|flat|light）：见 docs/CCD_CALIBRATION.md
# TELBOT_CAL_BIAS_EXPOSURE_SECONDS=0
# TELBOT_CAL_DARK_EXPOSURE_SECONDS=0
# TELBOT_CAL_FLAT_EXPOSURE_SECONDS=1.0
# TELBOT_CAL_BIAS_COUNT=20
# TELBOT_CAL_DEFAULT_COUNT=10
# Filter wheel for `telbot filter`（与 indi_getprop 设备名一致，如 QHYCFW3）
# TELBOT_INDI_CFW_DEVICE=QHYCFW3
# Focuser for `telbot focuser`（与 indi_getprop 设备名一致，如 Oasis Focuser）
# TELBOT_INDI_FOCUSER_DEVICE=Oasis Focuser
# Autofocus (telbot focuser autofocus); needs pip install -e ".[autofocus]"
# TELBOT_AUTOFOCUS_EXPOSURE_SECONDS=0
# TELBOT_AUTOFOCUS_COARSE_STEP=200
# TELBOT_AUTOFOCUS_FINE_STEP=50
# TELBOT_AUTOFOCUS_HALF_RANGE_STEPS=800
# TELBOT_CCD_DEFAULT_EXPOSURE_SECONDS=1.0
# TELBOT_CCD_SNAP_SETTLE_SECONDS=3.0
# CCD FITS 根目录：留空则默认 ~/Telbot/data/ccd_captures；每次拍照会自动使用其子目录 YYYYMMDD（如 20260520），并由 Telbot 设置 INDI UPLOAD_DIR
# TELBOT_CCD_SAVE_DIR=
# expose_loop（telbot camera expose-loop）：每帧间隔默认 = 曝光 + overhead；--session 或此项指定会话子目录（如 transit_WASP12b）
# TELBOT_EXPOSE_LOOP_OVERHEAD_SECONDS=5.0
# TELBOT_CCD_SESSION_TAG=
# Exoplanet transit plan (telbot plan transit-build / transit-run)
# TELBOT_TRANSIT_BASELINE_H=1.0
# TELBOT_TRANSIT_BASELINE_K=1.5
# TELBOT_TRANSIT_DEFAULT_FILTER=Clear
# TELBOT_TRANSIT_EXPOSURE_SECONDS=0          # >0 时跳过 ETC，强制该曝光（秒）
# TELBOT_TRANSIT_INCLUDE_AUTOFOCUS=true
# TELBOT_TRANSIT_INCLUDE_PLATESOLVE=false
# ingress 前预检拍照（默认 ingress 前 10 分钟；App 读 GET /plan/transit/ingress-precheck）
# TELBOT_TRANSIT_INCLUDE_INGRESS_PRECHECK=true
# TELBOT_TRANSIT_INGRESS_PRECHECK_MIN=10.0
# TELBOT_TRANSIT_INGRESS_PRECHECK_EXPOSURE_SECONDS=0   # 0=与科学段曝光一致
# TELBOT_TRANSIT_INGRESS_PRECHECK_MAX_OFFSET_ARCMIN=8.0
# TELBOT_TRANSIT_INGRESS_PRECHECK_FAIL_POLICY=continue # continue | abort
# TELBOT_TRANSIT_PENDING_TTL_HOURS=12.0
# OTA 光学（ETC 自动解析；0=从选镜 profile / CCD 登记表 / 板解 推断）
# TELBOT_OTA_APERTURE_MM=0
# TELBOT_OTA_FOCAL_LENGTH_MM=0
# Transit ETC（plan transit-build 默认用 ETC 算曝光，写入 plan JSON instrument_profile.etc）
# TELBOT_TRANSIT_ETC_APERTURE_MM=200.0
# TELBOT_TRANSIT_ETC_FOCAL_LENGTH_MM=1000.0
# TELBOT_TRANSIT_ETC_PIXEL_SIZE_UM=5.5
# TELBOT_TRANSIT_ETC_READ_NOISE_E=3.0
# TELBOT_TRANSIT_ETC_FULL_WELL_E=60000.0
# TELBOT_TRANSIT_ETC_APERTURE_RADIUS_PIX=12.0
# TELBOT_TRANSIT_ETC_SEEING_ARCSEC=2.0
# TELBOT_TRANSIT_ETC_SKY_MAG_PER_ARCSEC2=21.0
# TELBOT_TRANSIT_ETC_SYSTEM_THROUGHPUT=0.35
# TELBOT_TRANSIT_ETC_TARGET_SNR_ON_DEPTH=5.0
# TELBOT_TRANSIT_ETC_MIN_EXPOSURE_SECONDS=1.0
# TELBOT_TRANSIT_ETC_MAX_EXPOSURE_SECONDS=600.0
# Plate solve（ASTAP + astropy）：pip install -e ".[platesolve]"；Pi 上 apt 安装 astap 或官方二进制
# TELBOT_PLATESOLVE_BACKEND=astap
# TELBOT_PLATESOLVE_ASTAP_BIN=astap
# TELBOT_PLATESOLVE_TIMEOUT_S=180
# TELBOT_PLATESOLVE_STAR_DATABASE_DIR=
# indi_getprop -t (seconds). Lower = faster nudge/read-coord on many setups; raise if reads fail.
# TELBOT_INDI_GETPROP_TIMEOUT=1.0

# HTTP API（telbot serve / App）：`telbot serve restart` 默认绑定与端口
# TELBOT_SERVE_HOST=0.0.0.0
# TELBOT_SERVE_PORT=8765
# Pi 上更新代码后：cd ~/Telbot && telbot serve restart -r

# Observer for ephem / horizon (degrees, meters). Legacy: TELBOT_LATITUDE_DEG / TELBOT_LONGITUDE_DEG still work.
# Skyfield 星历 de421.bsp 默认目录 ~/Telbot（与 Pi 部署一致；非当前工作目录）。可覆盖：
# TELBOT_SKYFIELD_DATA_DIR=~/Telbot
TELBOT_LATITUDE=31.2
TELBOT_LONGITUDE=121.5
TELBOT_ELEVATION_M=10
# Optional: minimum apparent altitude (°). Default -0.5; use 0 to forbid anything below geometric horizon.
# TELBOT_MIN_ALTITUDE_DEG=-0.5

# Optional: semantic intent (telbot text 默认在规则未命中时用句向量；--no-semantic 可关闭), see README
# TELBOT_SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# TELBOT_SEMANTIC_THRESHOLD=0.42

# Optional: cloud STT for `telbot listen` (OpenAI-compatible /v1/audio/transcriptions). Needs: pip install -e ".[voice]" + arecord.
# TELBOT_OPENAI_API_KEY=
# TELBOT_OPENAI_BASE_URL=
# TELBOT_OPENAI_TRANSCRIPTION_MODEL=whisper-1
# TELBOT_SPEECH_LANGUAGE=zh
# TELBOT_ALSA_ARECORD_DEVICE=default
# 留空或 default：`telbot listen` 用 arecord -l 自动选 USB 等采集卡（可看图上提示写入下行固定设备）
# TELBOT_LISTEN_DEFAULT_SECONDS=3

# Optional: cloud LLM intent (SiliconFlow + Qwen, OpenAI-compatible chat). pip install -e ".[llm]"
# TELBOT_INTENT_USE_LLM=true
# TELBOT_LLM_API_KEY=           # 空则复用 TELBOT_OPENAI_API_KEY
# TELBOT_LLM_BASE_URL=          # 空则复用 TELBOT_OPENAI_BASE_URL，再空则默认 https://api.siliconflow.cn/v1
# TELBOT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- 观测计划（阶段 0+，见 README「观测计划」）---
# 自动「今晚」：太阳视高度低于该值（°）视为夜窗；-6 民用昏影终、-12 航海、-18 天文
# TELBOT_PLAN_NIGHT_SUN_ALTITUDE_THRESHOLD_DEG=-6
# 标注用 IANA 时区；留空则用系统本地（如 Pi 已设 Asia/Shanghai）
# TELBOT_PLAN_TIMEZONE=Asia/Shanghai
# TELBOT_PLAN_DEFAULT_EXPOSURE_SECONDS=60
# 规划时目标最低高度角（°），与 GOTO 的 TELBOT_MIN_ALTITUDE_DEG 可不同
# TELBOT_PLAN_TARGET_MIN_ALTITUDE_DEG=30
# TELBOT_PLAN_CONSIDER_MOON=true
# 月亮照亮度超过该百分数时，后续阶段可压低暗弱目标权重
# TELBOT_PLAN_MOON_ILLUMINATION_MAX_PCT_FOR_FAINT=50
# conservative | advanced（advanced 留作子午线翻转细排程）
# TELBOT_PLAN_MERIDIAN_FLIP_STRATEGY=conservative
# TELBOT_PLAN_MERIDIAN_BUFFER_MINUTES=10
# open_meteo（无需 key）| seven_timer | qweather | none
# TELBOT_PLAN_WEATHER_PROVIDER=open_meteo
# TELBOT_PLAN_WEATHER_API_KEY=
# TELBOT_PLAN_WEATHER_QUERY_INTERVAL_MINUTES=30
# 阶段 2：星表与排程（需 telbot catalog download-openngc）
# messier | ngc_bright | messier_ngc
# TELBOT_PLAN_CATALOG_SOURCES=messier
# TELBOT_PLAN_NGC_MAX_VMAG=10
# TELBOT_PLAN_CANDIDATE_LIMIT=120
# TELBOT_PLAN_GOTO_BUFFER_SECONDS=120
# 禁区方位（°，自北顺时针），逗号分隔区间，例如遮挡/避雷针方向
# TELBOT_PLAN_FORBIDDEN_AZIMUTH_DEG_RANGES=
# TELBOT_PLAN_PHASE2_TIME_STEP_MINUTES=15
# 高于此 V-Mag（或缺省星等）的目标在月亮过亮时标记 moon_downrank
# TELBOT_PLAN_FAINT_VMAG_THRESHOLD=10
# 阶段 5：运行中天气监控（telbot plan monitor）
# TELBOT_PLAN_MONITOR_INTERVAL_MINUTES=30
# TELBOT_PLAN_MONITOR_FORECAST_HORIZON_HOURS=3
# TELBOT_PLAN_MONITOR_PARK_MEAN_CLOUD_PCT=85
# TELBOT_PLAN_MONITOR_PARK_PRECIP_PROB_PCT=55
# TELBOT_PLAN_MONITOR_PARK_WIND_MS=18
# 系外行星凌星（telbot plan transits / 语音 exoplanet_transits）；需 pip install -e ".[exoplanets]"
# TELBOT_EXOPLANET_MAX_HOST_VMAG=12
# TELBOT_EXOPLANET_MIN_ALTITUDE_DEG=30
# TELBOT_EXOPLANET_CATALOG_SCAN_LIMIT=150
# TELBOT_EXOPLANET_MAX_RESULTS=15
# TELBOT_EXOPLANET_CONSIDER_MOON=true
