ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="338f", ATTR{idProduct}=="a0f0", RUN+="/usr/bin/systemd-run --collect --no-block /usr/local/lib/telbot-deploy/telbot-udev-select-mount.sh"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="338f/a0f0/*", RUN+="/usr/bin/systemd-run --collect --no-block /usr/local/lib/telbot-deploy/telbot-udev-select-mount.sh"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="338f/*", RUN+="/usr/bin/systemd-run --collect --no-block /usr/local/lib/telbot-deploy/telbot-udev-select-mount.sh"

