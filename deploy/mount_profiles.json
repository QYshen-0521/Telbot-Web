{
  "version": 1,
  "auto_connect_by_driver": {
    "indi_lx200gemini": { "device_from": "profile_hint" },
    "indi_celestron_gps": { "device_from": "profile_hint" },
    "indi_sbig_ccd": { "device": "SBIG CCD", "env": "TELBOT_INDI_CCD_DEVICE" },
    "indi_asi_ccd": { "device": "ZWO CCD ASI294MC Pro", "env": "TELBOT_INDI_CCD_DEVICE" },
    "indi_qhy_ccd": { "device": "QHY CCD QHY174M", "env": "TELBOT_INDI_CCD_DEVICE" },
    "indi_oasis_focuser": { "device": "Oasis Focuser", "env": "TELBOT_INDI_FOCUSER_DEVICE" },
    "indi_qhycfw3_wheel": { "device": "QHYCFW3", "env": "TELBOT_INDI_CFW_DEVICE" },
    "indi_planewave_telescope": {
      "device_from": "profile_hint",
      "pre_connect_setprop": [
        "PlaneWave.DEVICE_ADDRESS.ADDRESS=127.0.0.1",
        "PlaneWave.DEVICE_ADDRESS.PORT=8220",
        "PlaneWave.CONNECTION.DISCONNECT=Off"
      ],
      "post_connect_pwi4_mount": true
    },
    "indi_simulator_telescope": { "skip": true }
  },
  "on_no_usb_match": {
    "action": "restart",
    "indiserver_args_line": "-v indi_simulator_telescope",
    "mount_profile_id": "no_usb_idle",
    "device_name_hint": "Telescope Simulator",
    "telbot_env_sync": false
  },
